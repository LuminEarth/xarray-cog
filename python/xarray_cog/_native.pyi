"""Static interface for the private PyO3 output writer."""
from os import PathLike
from types import TracebackType
from typing import Any

from numpy.typing import NDArray

class NativeWriter:
    def __init__(self, path: str | PathLike[str], config: str) -> None: ...
    @property
    def num_threads(self) -> int: ...
    @property
    def batch_size(self) -> int: ...
    @property
    def source_cache_budget(self) -> int: ...
    def __enter__(self) -> NativeWriter: ...
    def __exit__(self, exc_type: type[BaseException] | None,
                 exc_value: BaseException | None, traceback: TracebackType | None) -> None: ...
    def write_tiles(self, tiles: list[NDArray[Any]]) -> None: ...
    def finish(self) -> None: ...
    def close(self) -> None: ...
